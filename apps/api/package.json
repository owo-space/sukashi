{
  "name": "@sukashi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sukashi/shared build && nest start --watch",
    "build": "pnpm prisma:generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --config ../../prisma.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/static": "9.1.3",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.23",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.23",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "11.1.23",
    "@nestjs/schedule": "6.1.3",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@sukashi/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "bullmq": "5.77.2",
    "fastify": "5.8.5",
    "ioredis": "5.10.1",
    "msgpackr": "2.0.1",
    "nodemailer": "8.0.10",
    "stripe": "20.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.14",
    "@types/node": "25.9.1",
    "@types/nodemailer": "8.0.0",
    "prisma": "7.8.0",
    "typescript": "6.0.3"
  }
}
